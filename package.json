{
  "name": "notes",
  "version": "1.0.0",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "start": "pnpm run build && go run .",
    "build": "rm -rf public/editor && esbuild src/editor.js --bundle --format=esm --splitting --outdir=public/editor --chunk-names=[name]-[hash] --minify",
    "watch": "rm -rf public/editor && esbuild src/editor.js --bundle --format=esm --splitting --outdir=public/editor --chunk-names=[name]-[hash] --sourcemap --watch"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.28.2"
  }
}
